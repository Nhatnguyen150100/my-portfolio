# Resend API key — required for the contact form to actually send email.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form messages are delivered.
# Optional — defaults to nhatnguyen150100@gmail.com in the server action.
CONTACT_TO_EMAIL=nhatnguyen150100@gmail.com

# Verified sender address. Until you verify your own domain in Resend,
# keep the shared test sender below (it can only deliver to your Resend
# account's own email). After verifying a domain, use e.g.
# "Portfolio Contact <hello@your-domain.com>".
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"
